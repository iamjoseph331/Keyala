    "Sent to your Keyala server over HTTPS and encrypted there. Saving does not make a billable model call.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Key 會透過 HTTPS 傳送至你的 Keyala 伺服器，並加密儲存。儲存時不會進行付費的模型呼叫。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーは HTTPS で Keyala サーバーに送信され、暗号化して保存されます。保存時に課金対象のモデル呼び出しは行いません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent to your Keyala server over HTTPS and encrypted there. Saving does not make a billable model call."
          }
        }
      },
      "extractionState": "manual"
    },
