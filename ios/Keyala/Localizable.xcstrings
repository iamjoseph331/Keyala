    "Off by default. Only one-call approvals with an estimate of $0.05 or less can use this shortcut. Larger estimates open the review sheet.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設關閉。只有已載入且估價不超過 $0.05 的請求，可以透過此捷徑批准一次。估價較高的請求會開啟審閱頁。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期設定はオフです。読み込み済みで見積額が $0.05 以下のリクエストだけを、今回限り許可できます。それより高い場合は確認画面を開きます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. Only one-call approvals with an estimate of $0.05 or less can use this shortcut. Larger estimates open the review sheet."
          }
        }
      },
      "extractionState": "manual"
    },
