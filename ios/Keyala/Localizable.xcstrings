          }
        }
      }
    },
    "You can still sign in by scanning the web sign-in QR with Keyala.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can still sign in by scanning the web sign-in QR with Keyala."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你仍可使用 Keyala 掃描網頁登入 QR code 來登入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引き続き Keyala でウェブログイン用 QR コードを読み取ってログインできます。"
          }
        }
      }
    },
    "Send console link": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send console link"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送控制台連結"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンソールのリンクを送信"
          }
        }
      }
    },
    "Choose phone sign-in. Scan the QR using your iPhone Camera or Keyala’s QR scanner, then review and approve the browser.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose phone sign-in. Scan the QR using your iPhone Camera or Keyala’s QR scanner, then review and approve the browser."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇手機登入，使用 iPhone 相機或 Keyala 的 QR 掃描器掃描，再確認並批准瀏覽器登入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンでのログインを選び、iPhone のカメラまたは Keyala の QR スキャナで読み取って、ブラウザを確認して許可してください。"
          }
        }
      }
    },
    "Can’t scan? Paste the sign-in link": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t scan? Paste the sign-in link"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法掃描？貼上登入連結"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取れない場合はログインリンクを貼り付け"
          }
        }
      }
    },
    "Review web sign-in": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review web sign-in"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認網頁登入"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウェブログインを確認"
          }
        }
      }
    },
    "Apple manages your sign-in identity. Change your email or Apple Account settings with Apple. You can set a separate web password in Settings > Web password.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple manages your sign-in identity. Change your email or Apple Account settings with Apple. You can set a separate web password in Settings > Web password."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 管理你的登入身分。請向 Apple 變更電子郵件或 Apple 帳號設定；你可以在「設定 > 網頁密碼」另設網頁登入密碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン情報は Apple が管理します。メールアドレスや Apple Account の設定は Apple で変更してください。「設定 > ウェブ用パスワード」で別のパスワードを設定できます。"
          }
        }
      }
    },
    "Password sign-in": {
      "extractionState": "manual",
      "localizations": {
