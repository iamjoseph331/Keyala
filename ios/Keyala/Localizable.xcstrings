          "stringUnit": {
            "state": "translated",
            "value": "Connect OpenRouter in Keys first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先到「金鑰」連接 OpenRouter。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず「キー」で OpenRouter に接続してください。"
          }
        }
      }
    },
    "Off by default. New OpenAI and Anthropic app connections can use supported models with your OpenRouter key and credits. Requests pass through OpenRouter and its downstream providers; prices follow OpenRouter.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. New OpenAI and Anthropic app connections can use supported models with your OpenRouter key and credits. Requests pass through OpenRouter and its downstream providers; prices follow OpenRouter."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設關閉。新連結的 OpenAI 與 Anthropic App 可透過你的 OpenRouter 金鑰與 credits 使用支援的模型。請求會經過 OpenRouter 及其下游服務商，費用依 OpenRouter 計算。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期設定はオフです。新しく接続する OpenAI・Anthropic 対応アプリで、OpenRouter のキーとクレジットを使えます。対象は対応モデルのみです。リクエストは OpenRouter とその先の提供事業者に送られ、料金は OpenRouter に従います。"
          }
        }
      }
    },
    "Existing app connections keep their billing provider. Disconnect and reconnect an app to change its route. Unsupported models and API features are not converted.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing app connections keep their billing provider. Disconnect and reconnect an app to change its route. Unsupported models and API features are not converted."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "既有 App 連結會維持原付款來源。若要改變轉送方式，請先中斷再重新連結；不支援的模型與 API 功能不會自動轉換。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続済みアプリの請求先は変わりません。経路を変えるには接続を解除して、再接続してください。未対応のモデルや API 機能は自動変換しません。"
          }
        }
      }
    },
    "Don’t show this guide again": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don’t show this guide again"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不再顯示此引導"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この案内を今後表示しない"
          }
        }
      }
    },
    "Show routing guide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show routing guide"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示轉送功能引導"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転送機能の案内を表示"
          }
        }
      }
    },
    "Billed through OpenRouter credits": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Billed through OpenRouter credits"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由 OpenRouter credits 付款"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenRouter クレジットで支払い"
          }
        }
      }
    },
    "This connection uses supported models through OpenRouter, including its downstream providers, instead of a direct provider key.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This connection uses supported models through OpenRouter, including its downstream providers, instead of a direct provider key."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個連結透過 OpenRouter 及其下游服務商使用支援的模型，不會使用原服務商的直接 API 金鑰。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この接続では直接の API キーを使わず、OpenRouter とその先の提供事業者を通じて対応モデルを利用します。"
          }
        }
      }
    },
    "The billing route changed. Review the refreshed connection before approving again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The billing route changed. Review the refreshed connection before approving again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "付款轉送方式已改變。請重新審閱連結內容後再批准。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払い経路が変わりました。更新された接続内容を確認してから、もう一度許可してください。"
          }
        }
      }
    },
    "Requests the %@ API through OpenRouter.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests the %@ API through OpenRouter."
