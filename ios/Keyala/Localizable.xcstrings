          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenRouter 経由で %@ API を利用します。"
          }
        }
      }
    },
    "When OpenRouter routing is enabled, requests go through OpenRouter and its downstream providers and use OpenRouter credits.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When OpenRouter routing is enabled, requests go through OpenRouter and its downstream providers and use OpenRouter credits."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 OpenRouter 轉送後，請求會經過 OpenRouter 及其下游服務商，並使用 OpenRouter credits 付款。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenRouter 経由の転送を有効にすると、リクエストは OpenRouter とその先の提供事業者に送られ、OpenRouter クレジットで支払われます。"
          }
        }
      }
    },
