    "A $10 spending cap is suggested on the consent page. You can change it there.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "授權頁會建議設定 $10 的支出上限。你可以在該頁變更。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証ページでは $10 の利用上限を提案します。そのページで変更できます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A $10 spending cap is suggested on the consent page. You can change it there."
          }
        }
      },
      "extractionState": "manual"
    },
