    "Scan the key setup QR on your computer. You’ll approve this computer before it can send a key.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描電腦上的 key 設定 QR code。電腦必須先經過你的批准，才能傳送 key。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パソコンに表示されたキー設定用の QR コードをスキャンしてください。パソコンからキーを送信する前に、あなたの許可が必要です。"
          }
        },
        "en": {
