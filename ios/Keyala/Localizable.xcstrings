    },
    "An experimental personal project by Joseph Chen, built with care. The beta is free; provider usage is billed separately.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An experimental personal project by Joseph Chen, built with care. The beta is free; provider usage is billed separately."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是 Joseph Chen 認真開發的個人實驗性專案。Beta 免費，模型服務的 API 費用另計。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Joseph Chen が丁寧に開発する、個人の実験的なプロジェクトです。ベータ版は無料ですが、API 利用料は別途かかります。"
          }
        }
      }
    },
    "Your selected Keyala server stores encrypted keys and decrypts them to forward approved requests. You must trust its operator. Apps get permission tokens, not your original key.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your selected Keyala server stores encrypted keys and decrypts them to forward approved requests. You must trust its operator. Apps get permission tokens, not your original key."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你選擇的 Keyala 伺服器會加密保存金鑰，並在轉送允許的請求時解密。你仍須信任營運者；App 只會取得授權權杖，不會取得原始金鑰。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ Keyala サーバーがキーを暗号化して保存し、許可されたリクエストの転送時に復号します。運営者への信頼は必要です。アプリに渡るのは許可用のトークンで、元のキーではありません。"
          }
        }
      }
    },
    "After signing in, open Keys. Connect OpenRouter with its authorization screen, or add an OpenAI or Anthropic API key from your phone or computer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After signing in, open Keys. Connect OpenRouter with its authorization screen, or add an OpenAI or Anthropic API key from your phone or computer."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入後開啟「金鑰」。可透過授權畫面連結 OpenRouter，或從手機、電腦加入 OpenAI 或 Anthropic API key。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン後に「キー」を開きます。OpenRouter は認可画面から接続でき、OpenAI と Anthropic の API キーはスマートフォンかパソコンから追加できます。"
          }
        }
      }
    },
    "OpenRouter has its own credits. ChatGPT and Claude subscriptions do not include OpenAI or Anthropic API credits. Adding a key does not add a balance.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenRouter has its own credits. ChatGPT and Claude subscriptions do not include OpenAI or Anthropic API credits. Adding a key does not add a balance."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenRouter 使用獨立的點數餘額。ChatGPT 與 Claude 訂閱不包含 OpenAI 或 Anthropic API 額度。加入金鑰不會增加餘額。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenRouter には独自の残高があります。ChatGPT や Claude のサブスクリプションに API の残高は含まれません。キーを追加しても残高は増えません。"
          }
        }
      }
    },
    "Start with a separate provider key and a small provider-side spending limit where available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with a separate provider key and a small provider-side spending limit where available."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建議先使用獨立的 API key；服務商有提供時，也請設定小額用量上限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "専用の API キーを用意し、プロバイダーが対応している場合は少額の利用上限を設定して始めてください。"
          }
        }
      }
    },
    "Start connecting from a supported app’s website. Scan its QR, check the source, then review the actual request and estimated cost before allowing one call.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start connecting from a supported app’s website. Scan its QR, check the source, then review the actual request and estimated cost before allowing one call."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從支援的 App 網頁開始連結。掃描 QR code、核對來源，再查看實際請求與預估費用，決定是否允許這一次呼叫。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応アプリのウェブサイトから接続を始めます。QR コードを読み取り、接続元を確認してから、実際の送信内容と見積額を見て、今回の呼び出しを許可するか決めます。"
          }
        }
      }
    },
    "Notifications are optional. Open Inbox to check waiting requests, Activity to inspect results, and Apps to revoke access. Settings > Account has account deletion and security controls.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are optional. Open Inbox to check waiting requests, Activity to inspect results, and Apps to revoke access. Settings > Account has account deletion and security controls."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知可自行選擇是否開啟。在「收件匣」查看待批准請求、「活動」查看結果、「App」撤銷授權。「設定 > 帳號」提供刪帳號及安全操作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知は任意です。「受信トレイ」で待機中のリクエスト、「履歴」で結果を確認し、「アプリ」で許可を取り消せます。「設定 > アカウント」には削除とセキュリティの操作があります。"
          }
        }
      }
    },
    "If a request is uncertain, check the original request and provider usage before starting another. It may already have run.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a request is uncertain, check the original request and provider usage before starting another. It may already have run."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若請求結果不確定，請先查看原請求與服務商用量，再建立新請求。它可能已經執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果が不確定の場合、すでに実行された可能性があります。新しいリクエストを作る前に、元の状態とプロバイダーの利用状況を確認してください。"
          }
        }
      }
    },
    "New here? Continuing creates your Keyala account. Returning users sign in to the same account.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New here? Continuing creates your Keyala account. Returning users sign in to the same account."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第一次使用？繼續即可建立 Keyala 帳號。既有使用者會登入原帳號。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初めての場合は、続けると Keyala アカウントが作成されます。以前利用した方は同じアカウントにログインします。"
          }
        }
      }
    },
    "An experimental personal project by Joseph Chen, built with care. Provider usage is billed separately.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An experimental personal project by Joseph Chen, built with care. Provider usage is billed separately."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Joseph Chen 認真開發的個人實驗性專案。模型服務的 API 費用另計。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Joseph Chen が丁寧に開発する個人の実験的なプロジェクトです。API 利用料は別途かかります。"
          }
        }
      }
    },
    "Apple manages your sign-in identity. Change your email or Apple Account settings with Apple; Keyala does not have a separate account password.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple manages your sign-in identity. Change your email or Apple Account settings with Apple; Keyala does not have a separate account password."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入身分由 Apple 管理。請透過 Apple 修改電子郵件或 Apple 帳號設定；Keyala 沒有獨立的帳號密碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン情報は Apple が管理します。メールや Apple Account の設定は Apple 側で変更してください。Keyala 専用のパスワードはありません。"
          }
        }
      }
    },
    "Sign out on this iPhone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out on this iPhone"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登出這支 iPhone"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone からログアウト"
          }
        }
      }
    },
    "Security & access": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Security & access"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安全與存取"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュリティとアクセス"
          }
        }
      }
    },
    "Sign out other devices": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out other devices"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登出其他裝置"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の端末からログアウト"
          }
        }
      }
    },
    "Stop all app permissions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop all app permissions"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止所有 App 授權"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのアプリの許可を停止"
          }
        }
      }
    },
    "Signing out devices does not revoke app permissions. Stop permissions separately if an app or token may be compromised.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing out devices does not revoke app permissions. Stop permissions separately if an app or token may be compromised."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登出裝置不會撤銷 App 授權。若 App 或權杖可能外洩，請另外停止授權。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末からログアウトしてもアプリの許可は取り消されません。アプリやトークンに問題がある場合は、許可も別途停止してください。"
          }
        }
      }
    },
    "Delete account": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除帳號"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを削除"
          }
        }
      }
    },
    "Delete Keyala account": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Keyala account"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除 Keyala 帳號"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyala アカウントを削除"
          }
        }
      }
    },
    "Permanently remove your Keyala account, keys, permissions and history. Your provider accounts and subscriptions are separate.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently remove your Keyala account, keys, permissions and history. Your provider accounts and subscriptions are separate."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永久移除 Keyala 帳號、金鑰、授權與歷史。模型服務帳號與訂閱須另外管理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyala のアカウント、キー、許可、履歴を完全に削除します。プロバイダーのアカウントやサブスクリプションは別です。"
          }
        }
      }
    },
    "Sign out on this iPhone?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out on this iPhone?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要登出這支 iPhone 嗎？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone からログアウトしますか？"
          }
        }
      }
    },
    "This ends this device’s server session. Other devices and app permissions stay active.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This ends this device’s server session. Other devices and app permissions stay active."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會結束此裝置在伺服器上的登入工作階段。其他裝置與 App 授權仍有效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末のサーバー側セッションを終了します。他の端末とアプリの許可は有効なままです。"
          }
        }
      }
    },
    "Sign out other devices?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out other devices?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要登出其他裝置嗎？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の端末からログアウトしますか？"
          }
        }
      }
    },
    "This iPhone stays signed in. App permissions stay active until you stop them separately.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone stays signed in. App permissions stay active until you stop them separately."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支 iPhone 會保持登入。App 授權仍有效，須另外停止。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone はログインしたままです。アプリの許可は別途停止するまで有効です。"
          }
        }
      }
    },
    "Stop all app permissions?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop all app permissions?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要停止所有 App 授權嗎？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのアプリの許可を停止しますか？"
          }
        }
      }
    },
    "Stop permissions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop permissions"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止授權"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可を停止"
          }
        }
      }
    },
    "Every connected app will lose access. Unsent requests are denied. Already-sent requests may still finish; your keys stay stored.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every connected app will lose access. Unsent requests are denied. Already-sent requests may still finish; your keys stay stored."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有已連結 App 都會失去存取權，未送出的請求會被拒絕。已送出的請求仍可能完成；金鑰會繼續保存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続済みのすべてのアプリがアクセスできなくなり、未送信のリクエストは拒否されます。送信済みの処理は完了する場合があり、キーは保存されたままです。"
          }
        }
      }
    },
    "What will be deleted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What will be deleted"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將刪除的資料"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除されるもの"
          }
        }
      }
    },
    "Your Keyala account, stored provider keys, app permissions, sessions, and request and response history will be permanently removed from this server.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Keyala account, stored provider keys, app permissions, sessions, and request and response history will be permanently removed from this server."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Keyala 帳號、保存的服務商金鑰、App 授權、登入工作階段及請求與回應歷史，都會從此伺服器永久移除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーから Keyala アカウント、保存したキー、アプリの許可、セッション、リクエストとレスポンスの履歴を完全に削除します。"
          }
        }
      }
    },
    "Provider accounts, subscriptions and data already received by providers or apps are separate. Backups can retain older copies until expiration; deletion records must be applied before a restore is served.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provider accounts, subscriptions and data already received by providers or apps are separate. Backups can retain older copies until expiration; deletion records must be applied before a restore is served."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型服務帳號、訂閱，以及服務商或 App 已收到的資料不在刪除範圍。備份可能在到期前保有舊副本；復原服務前須套用刪除紀錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーのアカウント、サブスクリプション、外部に送信済みのデータは対象外です。バックアップには期限まで古いコピーが残る場合があり、復旧時にはサービス再開前に削除記録を反映します。"
          }
        }
      }
    },
    "If a provider request is being sent, wait for it to finish and try deletion again. Deletion cannot recall a request already sent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a provider request is being sent, wait for it to finish and try deletion again. Deletion cannot recall a request already sent."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若正在轉送模型請求，請等處理結束再嘗試刪帳號。刪帳號無法收回已送出的請求。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーへの送信中は、終了してから削除をやり直してください。アカウントを削除しても送信済みのリクエストは取り消せません。"
          }
        }
      }
    },
    "Confirm account deletion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm account deletion"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認刪除帳號"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント削除の確認"
          }
        }
      }
    },
    "Type DELETE to confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type DELETE to confirm"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入 DELETE 以確認"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認のため DELETE と入力"
          }
        }
      }
    },
    "Continue with Apple to verify the same account again. Completing verification deletes your Keyala account.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue with Apple to verify the same account again. Completing verification deletes your Keyala account."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續使用 Apple，再次驗證同一帳號。驗證成功後會刪除你的 Keyala 帳號。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple で同じアカウントの本人確認を行います。確認が完了すると Keyala アカウントが削除されます。"
          }
        }
      }
    },
    "Account password": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account password"
          }
        },
        "zh-Hant": {
          "stringUnit": {
