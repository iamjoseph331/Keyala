        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 會建立獨立的 Keyala 帳號，不需要 Apple 帳號。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google で独立した Keyala アカウントを作成します。Apple アカウントは不要です。"
          }
        }
      }
    },
    "Google manages your sign-in identity. This Keyala account is independent of Sign in with Apple.": {
      "extractionState": "manual",
      "localizations": {
