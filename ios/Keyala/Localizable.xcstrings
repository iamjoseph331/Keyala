          }
        }
      }
    },
    "You will need another passkey or your original sign-in provider to sign in again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will need another passkey or your original sign-in provider to sign in again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下次登入時，你需要使用另一組 Passkey 或原本的登入方式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回のサインインには、別のパスキーか元のログイン方法が必要です。"
          }
        }
      }
    },
    "Passkeys sign in to this Keyala account with your device or credential manager. They do not require an Apple sign-in account.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passkeys sign in to this Keyala account with your device or credential manager. They do not require an Apple sign-in account."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Passkey 可透過你的裝置或憑證管理工具登入此 Keyala 帳號，不需要 Apple 登入帳號。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスキーは端末や認証情報マネージャーを使って、この Keyala アカウントにサインインします。Apple のログインアカウントは不要です。"
          }
        }
      }
    },
    "Create a passkey after signing in. To use another device, use your credential manager’s sync or the system’s nearby-device option.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a passkey after signing in. To use another device, use your credential manager’s sync or the system’s nearby-device option."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入後即可建立 Passkey。跨裝置使用時，請透過憑證管理工具同步，或使用系統提供的附近裝置選項。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインイン後にパスキーを作成できます。別の端末では、認証情報マネージャーの同期やシステムの近くの端末を使う機能をご利用ください。"
          }
        }
      }
    },
    "Removing a passkey disables it on this server. Your credential manager may keep its saved copy; remove that copy there if needed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removing a passkey disables it on this server. Your credential manager may keep its saved copy; remove that copy there if needed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除後，此伺服器將不再接受該 Passkey。憑證管理工具可能仍保留副本；如有需要，請在該工具中刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除すると、このサーバーではそのパスキーを使えなくなります。認証情報マネージャーに保存されたコピーは、必要に応じてそちらで削除してください。"
          }
        }
      }
    },
    "Passkey added. You can now use it to sign in to this Keyala account.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passkey added. You can now use it to sign in to this Keyala account."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已新增 Passkey，現在可以用它登入此 Keyala 帳號。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスキーを追加しました。この Keyala アカウントへのサインインに使えます。"
          }
        }
      }
    },
    "Verify the same Google account again to permanently delete this Keyala account.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify the same Google account again to permanently delete this Keyala account."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請再次驗證同一個 Google 帳號，以永久刪除此 Keyala 帳號。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Keyala アカウントを完全に削除するには、同じ Google アカウントで再確認してください。"
          }
        }
      }
    },
