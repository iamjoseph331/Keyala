          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントのパスワード"
          }
        }
      }
    },
    "Permanently delete account": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently delete account"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永久刪除帳號"
          }
        },
        "ja": {
