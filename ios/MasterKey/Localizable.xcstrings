    "Set up a device passcode or biometrics in iPhone Settings to enable approval verification.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在 iPhone「設定」中設定裝置密碼或生物辨識，才能啟用批准驗證。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone の「設定」でパスコードまたは生体認証を設定すると、許可時の本人確認を有効にできます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up a device passcode or biometrics in iPhone Settings to enable approval verification."
          }
