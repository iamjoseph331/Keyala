    "Apps receive permission to use a provider. They never receive your key.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps 取得使用服務商的權限，不會收到你的 key。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリにはプロバイダーの利用権限だけが渡され、キー自体は渡されません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps receive permission to use a provider. They never receive your key."
          }
        }
      },
      "extractionState": "manual"
    },
    "Available when the server enables development login.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在伺服器啟用開發用登入時可用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーで開発用ログインが有効な場合に利用できます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available when the server enables development login."
          }
        }
      },
      "extractionState": "manual"
    },
