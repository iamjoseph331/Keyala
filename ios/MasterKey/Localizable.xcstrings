    "Connected apps will use the new key under their existing permissions. The previous key is not revoked at the provider.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected apps will use the new key under their existing permissions. The previous key is not revoked at the provider."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已連結 App 會依原授權使用新金鑰。舊金鑰不會在服務商端被撤銷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続済みアプリは現在の許可の範囲で新しいキーを使います。古いキーはプロバイダー側では失効しません。"
          }
        }
      }
    },
