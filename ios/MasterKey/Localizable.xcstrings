          "stringUnit": {
            "state": "translated",
            "value": "Sample data is offline. Turn it off in Developer options to save a key."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "範例資料僅供離線使用。請在開發者選項中關閉，才能儲存 key。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンプルデータはオフライン用です。キーを保存するには、開発者向け設定でオフにしてください。"
          }
        }
      }
    },
    "Key saved. The provider could not verify it; check the key’s permissions if requests fail.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key saved. The provider could not verify it; check the key’s permissions if requests fail."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Key 已儲存，但服務商無法驗證。若請求失敗，請確認 key 的權限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを保存しました。プロバイダーで確認できなかったため、リクエストに失敗する場合はキーの権限を確認してください。"
          }
        }
      }
    },
    "Key saved. Apps receive permission to use it, never the key itself.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key saved. Apps receive permission to use it, never the key itself."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Key 已儲存。Apps 只取得使用權限，不會收到 key。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを保存しました。アプリには利用権限だけが渡され、キー自体は渡されません。"
          }
        }
      }
    },
    "OpenRouter is still finishing. Refresh Keys before starting another connection.": {
