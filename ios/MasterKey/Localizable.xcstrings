    "Fake requests and grants on this device only. No network requests, real keys, provider calls or charges. Switching this setting signs you out.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在這台裝置上顯示假的請求與授權。不會傳送網路請求、真實 key 或服務商呼叫，也不會產生費用。切換此設定會將你登出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイス上だけで架空のリクエストとアクセス権を表示します。通信、実際のキーの送信、プロバイダーの呼び出し、課金はありません。この設定を切り替えるとログアウトします。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fake requests and grants on this device only. No network requests, real keys, provider calls or charges. Switching this setting signs you out."
          }
        }
      },
      "extractionState": "manual"
    },
    "For building and testing integrations. Normal use connects to MasterKey automatically.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "供開發與測試整合使用。一般使用時，App 會自動連上 MasterKey。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発と連携テスト用です。通常の利用では MasterKey に自動で接続します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For building and testing integrations. Normal use connects to MasterKey automatically."
          }
        }
      },
      "extractionState": "manual"
    },
    "For password sign-in on staging, ask the server operator for a test account.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要在 staging 使用密碼登入，請向伺服器營運者索取測試帳號。"
          }
