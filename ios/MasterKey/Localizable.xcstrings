    "Allow the computer showing this QR to submit one %@ key to your account.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許顯示這個 QR code 的電腦，向你的帳號提交一個 %@ key。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この QR コードを表示しているパソコンから、アカウントに %@ のキーを 1 つ送信することを許可します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the computer showing this QR to submit one %@ key to your account."
          }
        }
      },
      "extractionState": "manual"
    },
