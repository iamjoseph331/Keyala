    "This app loses permission to use this provider. Your stored key and past history stay. Requests already sent may still finish.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app loses permission to use this provider. Your stored key and past history stay. Requests already sent may still finish."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 App 會失去使用這個模型服務的授權。已保存的金鑰與歷史會保留；已送出的請求仍可能完成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリはプロバイダーを利用できなくなります。保存したキーと履歴は残り、送信済みの処理は完了する場合があります。"
          }
        }
      }
    },
    "App disconnected.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App disconnected."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
