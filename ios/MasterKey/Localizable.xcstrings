    "Demo policy changes are not sent to a server.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo policy changes are not sent to a server."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
