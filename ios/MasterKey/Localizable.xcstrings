    "Can’t scan? Enter the code": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法掃描？輸入代碼"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンできない場合はコードを入力"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t scan? Enter the code"
          }
        }
      },
      "extractionState": "manual"
    },
    "Can’t scan? Paste the setup link": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法掃描？貼上設定連結"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンできない場合は設定リンクを貼り付け"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t scan? Paste the setup link"
          }
        }
      },
      "extractionState": "manual"
    },
    "Change policy": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "變更存取規則"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセス設定を変更"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change policy"
          }
        }
      },
      "extractionState": "manual"
    },
    "Changing servers signs you out. Remote servers require HTTPS; local HTTP is for a private development backend only.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "變更伺服器會將你登出。遠端伺服器必須使用 HTTPS；本機 HTTP 僅供私人開發後端使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーを変更するとログアウトします。リモートサーバーには HTTPS が必要です。ローカル HTTP は非公開の開発用バックエンド専用です。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing servers signs you out. Remote servers require HTTPS; local HTTP is for a private development backend only."
          }
        }
      },
      "extractionState": "manual"
    },
    "Check setup status": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看設定狀態"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定状況を確認"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check setup status"
          }
        }
      },
      "extractionState": "manual"
    },
    "Check that these last four characters match the key you pasted. The full key is never sent to this phone.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請確認這四個末碼與你貼上的 key 相符。完整 key 絕不會傳到這台手機。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "末尾の 4 文字が、貼り付けたキーと一致することを確認してください。キー全体がこの iPhone に送られることはありません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that these last four characters match the key you pasted. The full key is never sent to this phone."
          }
        }
      },
      "extractionState": "manual"
    },
    "Check that this host matches the page you’re using.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請確認這個主機名稱與你正在使用的網頁相符。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このホスト名が、利用中のページと一致することを確認してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that this host matches the page you’re using."
          }
        }
      },
      "extractionState": "manual"
    },
    "Check that this matches the address open on your computer. Approve only a setup you started yourself.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請確認這個網址與電腦上開啟的網址相符。僅批准你自己開始的設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パソコンで開いているアドレスと一致することを確認してください。自分で始めた設定だけを許可してください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that this matches the address open on your computer. Approve only a setup you started yourself."
          }
        }
      },
      "extractionState": "manual"
    },
    "Check the server and provider, then approve the computer. Paste the key on the computer and confirm its last four characters here before saving.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認伺服器與服務商，然後批准這台電腦。在電腦上貼上 key，並在這裡確認末四碼後再儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーとプロバイダーを確認して、パソコンを許可してください。パソコンにキーを貼り付け、ここで末尾の 4 文字を確認してから保存します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the server and provider, then approve the computer. Paste the key on the computer and confirm its last four characters here before saving."
          }
        }
      },
      "extractionState": "manual"
    },
    "Choose a provider. The page will show a QR code; no MasterKey password is needed on the computer.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇服務商後，網頁會顯示 QR code。電腦不需要輸入 MasterKey 密碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーを選ぶと QR コードが表示されます。パソコンで MasterKey のパスワードを入力する必要はありません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a provider. The page will show a QR code; no MasterKey password is needed on the computer."
          }
        }
